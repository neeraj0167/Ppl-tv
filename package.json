<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json");

$batchId = isset($_GET['id']) ? $_GET['id'] : '67790151310b930bc030052d';

$targetUrl = "https://pw4free.in/api/BatchInfo?BatchId=" . $batchId . "&Type=details";

$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $targetUrl);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept: application/json, text/plain, */*",
    "Referer: https://pw4free.in/study/batches/" . $batchId
]);

$response = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($httpCode !== 200 || !$response) {
    echo json_encode(["error" => "Failed to fetch data", "http_code" => $httpCode]);
} else {
    echo $response;
}
?>

